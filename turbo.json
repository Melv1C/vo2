{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "env:generate": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["env.d.ts"]
    },
    "env:validate": {
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
