{
  "name": "backend",
  "version": "0.2.1",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsdown",
    "db:audit": "bun run scripts/analyze-db-coherence.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen",
    "env:validate": "varlock load",
    "start": "bun run db:migrate && bun run src/index.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-fetch/fetch": "^1.3.1",
    "@hono/prometheus": "^1.0.3",
    "@repo/ai": "workspace:*",
    "@tanstack/ai": "^0.53.0",
    "@tanstack/ai-openrouter": "^0.19.8",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "varlock": "^1.17.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12"
  }
}
