    "pg": "^8.22.0",
    "varlock": "^1.16.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.9"
  }
